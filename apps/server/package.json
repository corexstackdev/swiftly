    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "ioredis": "^5.4.2",
    "mysql2": "^3.12.0",
    "nanoid": "^5.0.9",
