{
  "name": "@swiftly/shared",
  "version": "0.1.0",
  "private": true,
  "description": "The DSL, plugin and widget contracts the client and server compile against",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "dev": "tsc -p tsconfig.cjs.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
