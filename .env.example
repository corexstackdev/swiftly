# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3001

# Platform metadata store
# SQLite file, resolved relative to apps/server/prisma/.
DATABASE_URL="file:./dev.db"
REDIS_URL=redis://localhost:6409

# Sessions
SESSION_SECRET=change-me-to-a-long-random-value

# Datasource credential encryption (AES-256-GCM).
# Generate: openssl rand -hex 32   — rotating this invalidates stored credentials.
ENCRYPTION_KEY=

# Client origin for CORS
CLIENT_URL=http://localhost:5173

# --- Active Directory (LDAP), configured per organization in the admin console.
# These are fallback defaults for local development only.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# --- Entra ID / Azure AD (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback

# Query execution limits
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=10000

# Deployment region for this instance (see architecture section 9)
REGION=eu-west
